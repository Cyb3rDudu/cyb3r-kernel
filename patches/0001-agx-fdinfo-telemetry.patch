+    fn get_cur_utilization_bps(&self) -> Option<u32> {
+        // Idle reset is handled by FwBusy=0 and PowerOff in the stats channel.
+        Some(self.telemetry.utilization_bps.load(Ordering::Relaxed))
+    }
+
+    fn get_avg_power_mw(&self) -> Option<u32> {
+        let mw = self.telemetry.avg_power_mw.load(Ordering::Relaxed);
+        if mw == 0 { None } else { Some(mw) }
+    }
+
+    fn get_temp_c(&self) -> Option<u32> {
+        let raw = self.telemetry.temp_raw.load(Ordering::Relaxed);
+        let scale = self.telemetry.temp_scale.load(Ordering::Relaxed);
+        if scale > 0 && raw > 0 {
+            // Firmware fixed-point: temp = raw / scale / 64.0
+            // See m1n1 AGX channels.py decoder.
+            let divisor = (scale as u64) * 64;
+            let temp_c = ((raw as u64) + divisor / 2) / divisor;
+            Some(temp_c as u32)
+        } else {
+            self.initdata.runtime_pointers.with(|_, rp| {
+                rp.hwdata_a.with(|hwa, _| {
+                    let v = unsafe { core::ptr::read_volatile(core::ptr::addr_of!(hwa.temp_c)) };
+                    Some(v)
+                })
+            })
+        }
+    }
+
+    fn get_freq_mhz(&self) -> Option<u32> {
+        let pstate = self.telemetry.pstate.load(Ordering::Relaxed) as usize;
+        let states = &self.dyncfg.pwr.perf_states;
+        if pstate < states.len() {
+            let hz = states[pstate].freq_hz;
+            if hz > 0 {
+                return Some(hz / 1_000_000);
+            }
+        }
+        None
+    }
