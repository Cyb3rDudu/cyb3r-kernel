+/// C callback for drm_show_fdinfo().  Reports per-client GEM memory stats
+/// and global GPU telemetry from firmware (utilization, power, temp, freq).
+#[no_mangle]
+pub unsafe extern "C" fn asahi_show_fdinfo(
+    p: *mut kernel::bindings::drm_printer,
+    raw_file: *mut kernel::bindings::drm_file,
+) {
+    // SAFETY: Called from drm_show_fdinfo() under drm_dev_enter() which
+    // guarantees both pointers are valid for the duration of the call.
+    unsafe {
+        kernel::bindings::drm_show_memory_stats(p, raw_file);
+
+        let minor = (*raw_file).minor;
+        if minor.is_null() { return; }
+        let drm_dev = (*minor).dev;
+        if drm_dev.is_null() { return; }
+        // SAFETY: drm_dev is protected by drm_dev_enter() in the caller.
+        let device: &drm::device::Device<driver::AsahiDriver> =
+            drm::device::Device::from_raw(drm_dev);
+
+        if let Some(v) = device.gpu.get_cur_utilization_bps() {
+            if let Ok(s) = CString::try_from_fmt(fmt!("asahi-utilization:\t{} bps\n", v)) {
+                kernel::bindings::drm_printf_str(p, s.as_ptr());
+            }
+        }
+        if let Some(v) = device.gpu.get_avg_power_mw() {
+            if let Ok(s) = CString::try_from_fmt(fmt!("asahi-power-avg:\t{} mW\n", v)) {
+                kernel::bindings::drm_printf_str(p, s.as_ptr());
+            }
+        }
+        if let Some(v) = device.gpu.get_freq_mhz() {
+            if let Ok(s) = CString::try_from_fmt(fmt!("asahi-frequency:\t{} MHz\n", v)) {
+                kernel::bindings::drm_printf_str(p, s.as_ptr());
+            }
+        }
+        if let Some(v) = device.gpu.get_temp_c() {
+            if let Ok(s) = CString::try_from_fmt(fmt!("asahi-temperature:\t{} C\n", v)) {
+                kernel::bindings::drm_printf_str(p, s.as_ptr());
+            }
+        }
+    }
+}
