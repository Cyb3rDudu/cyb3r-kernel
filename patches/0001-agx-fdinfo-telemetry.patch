+/// Shared GPU telemetry updated from firmware stats channel.
+/// All fields use Relaxed ordering — independent monitoring values.
+pub(crate) struct GpuTelemetry {
+    pub(crate) utilization_bps: AtomicU32,  // util1 × 100, 0–10000
+    pub(crate) avg_power_mw: AtomicU32,     // from StatsMsg::AvgPower
+    pub(crate) pstate: AtomicU32,           // from StatsMsg::PowerState, u32::MAX = unknown
+    pub(crate) fw_busy: AtomicBool,         // from StatsMsg::FwBusy
+    pub(crate) temp_scale: AtomicU32,       // stored before temp_raw
+    pub(crate) temp_raw: AtomicU32,         // from StatsMsg::Temperature
+}
+
+impl GpuTelemetry {
+    fn new() -> Self {
+        Self {
+            utilization_bps: AtomicU32::new(0),
+            avg_power_mw: AtomicU32::new(0),
+            pstate: AtomicU32::new(u32::MAX),
+            fw_busy: AtomicBool::new(false),
+            temp_scale: AtomicU32::new(0),
+            temp_raw: AtomicU32::new(0),
+        }
+    }
+}
